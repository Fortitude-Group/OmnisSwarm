{
  "name": "omnis-swarm",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 \"tests/**/*.test.ts\"",
    "test:mod": "node scripts/test-mod.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.mod.json",
    "check": "npm run typecheck && npm test && npm run test:mod"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
